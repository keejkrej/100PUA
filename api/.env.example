# 100PUA API (Hono) — tracked template. Copy to `.env` in this folder and fill in secrets.
#
# Vars are loaded via `import 'dotenv/config'` in server.ts when you run npm start / npm run dev.

# --- HTTP ---
PORT=8787

# Comma-separated allowed browser origins for CORS, or * (default).
# For local Astro: http://localhost:4321,http://127.0.0.1:4321
ALLOWED_ORIGINS=*

# --- POST /suggestions (GitHub issues) ---
GITHUB_REPO=keejkrej/100PUA
GITHUB_TOKEN=

# Rate limit for POST /suggestions (per IP)
SUGGEST_RATE_LIMIT=20
SUGGEST_RATE_WINDOW_MS=900000

# --- POST /explain-prompt (Cursor) ---
# After editing topics, run: npm run build  (writes data/prompt-index.json)

CURSOR_API_KEY=

# Optional model id (default composer-2).
# CURSOR_MODEL=composer-2

EXPLAIN_RATE_LIMIT=12
EXPLAIN_RATE_WINDOW_MS=900000

# Optional max wait for explain generation (default 240000 ms).
# EXPLAIN_TIMEOUT_MS=240000

# --- explain response cache (default ./cache/explain under api/) ---
EXPLAIN_CACHE_DAYS=7
# EXPLAIN_CACHE_DEBUG=1
# EXPLAIN_CACHE_DIR=/var/data/explain-cache
# EXPLAIN_CACHE_DISABLED=1

# Optional hot cache tier: Render Key Value / Redis-compatible internal URL.
# Keep EXPLAIN_CACHE_DIR on persistent disk as the durable fallback if you have one.
# EXPLAIN_KV_URL=redis://...
# EXPLAIN_KV_CACHE_SECONDS=86400
# EXPLAIN_KV_PREFIX=100pua

# --- Maintainer tooling (optional) ---
#   npm run prewarm:explain -- --model composer-2
