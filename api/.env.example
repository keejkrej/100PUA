# 100PUA API (Hono) — tracked template. Copy to `.env` in this folder and fill in secrets.
#
# Vars are loaded via `import 'dotenv/config'` in server.ts when you run npm start / npm run dev.

# --- HTTP ---
PORT=8787

# Comma-separated allowed browser origins for CORS, or * (default).
# For local Astro: http://localhost:4321,http://127.0.0.1:4321
ALLOWED_ORIGINS=*

# --- POST /suggestions (GitHub issues) ---
GITHUB_REPO=keejkrej/100PUA
GITHUB_TOKEN=

# Rate limit for POST /suggestions (per IP)
SUGGEST_RATE_LIMIT=20
SUGGEST_RATE_WINDOW_MS=900000

# --- POST /explain-prompt ---
# After editing topics, run: npm run build  (writes data/prompt-index.json)
#
# JSON body supports optional `"provider":"claude"|"cursor"|"codex"` to pick the backend per request
# (the static site sends this when switching models). Omit to use EXPLAIN_AI_PROVIDER.

# Which backend when `provider` is omitted: claude | cursor | codex (default codex).
EXPLAIN_AI_PROVIDER=codex

# --- Claude (Anthropic Claude Agent SDK) — when EXPLAIN_AI_PROVIDER=claude ---
# Pick ONE (OAuth is subscription token from `claude setup-token`):
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional model id (omit to use default claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5

# --- Cursor (@cursor/sdk) — when EXPLAIN_AI_PROVIDER=cursor ---
# Local runtime: expects Cursor tooling available on this machine alongside Node.
CURSOR_API_KEY=
# Optional model id (default composer-2).
# CURSOR_MODEL=composer-2

# --- Codex (@openai/codex-sdk) — when EXPLAIN_AI_PROVIDER=codex ---
# SDK: https://github.com/openai/codex/tree/main/sdk/typescript · spawns `codex exec`.
#
# API key (usage billing): OPENAI_API_KEY and/or CODEX_API_KEY — SDK sets CODEX_API_KEY when using api_key mode.
#
# ChatGPT (OAuth / subscription): ensure auth.json is available to the CLI via CODEX_HOME, or paste JSON into
# CODEX_CHATGPT_AUTH_JSON (e.g. CI secret). When using ChatGPT auth, the API omits OPENAI_API_KEY/CODEX_API_KEY from
# the CLI env so they do not override OAuth (see Codex auth docs).
# CODEX_EXPLAIN_AUTH=auto
#   auto — use API key if OPENAI_API_KEY or CODEX_API_KEY is set; else ChatGPT OAuth if configured
#   api_key | chatgpt — force one mode (must have matching credentials).
# CODEX_HOME=/path/to/dir-with-auth-json
# CODEX_CHATGPT_AUTH_JSON={"...":"..."}
OPENAI_API_KEY=
# CODEX_API_KEY=
# CODEX_MODEL=gpt-5.5
# CODEX_WEB_SEARCH_MODE=live
# CODEX_SANDBOX_MODE=danger-full-access
# CODEX_APPROVAL_POLICY=never

CLAUDE_EXPLAIN_TIMEOUT_MS=240000

EXPLAIN_RATE_LIMIT=12
EXPLAIN_RATE_WINDOW_MS=900000

# --- explain response cache (default ./cache/explain under api/)
EXPLAIN_CACHE_DAYS=7
# EXPLAIN_CACHE_DEBUG=1
# EXPLAIN_CACHE_DIR=/var/data/explain-cache
# EXPLAIN_CACHE_DISABLED=1

# Optional hot cache tier: Render Key Value / Redis-compatible internal URL.
# Keep EXPLAIN_CACHE_DIR on persistent disk as the durable fallback if you have one.
# EXPLAIN_KV_URL=redis://...
# EXPLAIN_KV_CACHE_SECONDS=86400
# EXPLAIN_KV_PREFIX=100pua
