{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "server.ts",
    "explain-cache.ts",
    "explain-defaults.ts",
    "explain-runner.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
