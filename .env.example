# 100PUA Astro site — tracked template. Copy to `.env` at repo root and edit.
# Astro only exposes vars prefixed with PUBLIC_ to browser code.

# Hono API base URL (required for suggestion form + Claude prompt pages).
# Local default matches api/server.mjs (PORT=8787).
PUBLIC_SUGGEST_API_URL=http://127.0.0.1:8787

# Shown when the suggest UI falls back to opening a GitHub issue draft.
PUBLIC_GITHUB_REPO=keejkrej/100PUA
