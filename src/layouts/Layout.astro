---
import { ClientRouter } from 'astro:transitions';
import '../styles/layout.css';
---
<!DOCTYPE html>
<html lang="en" class="h-full bg-void" style="view-transition-name:root">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width">
  <meta name="color-scheme" content="dark">
  <ClientRouter fallback="animate" />
  <link rel="icon" href="https://t3.gg/favicon.svg">
  <meta name="description" content="theo (aka t3, t3dotgg) is a youtuber/ceo/dev. built t3 chat, ping.gg, t3 stack and more.">
  <meta name="theme-color" content="#050505">
  <title>theo</title>
  <!-- Optional Analytics -->
  <script defer data-domain="astro.t3.gg" src="https://plausible.io/js/script.js"></script>
</head>
<body class="min-h-full bg-void font-mono text-text selection:bg-accent/20">
  <slot />
</body>
</html>