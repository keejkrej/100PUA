---
import Layout from '../../layouts/Layout.astro';
import { buildChatQuery } from '../../lib/chat-query';
import manifest from '../../data/topics.manifest.json';
import nonequilibriumDoc from '../../data/nonequilibrium-lmu-ss2025.json';
import selfOrganizationDoc from '../../data/self-organization-lmu-ws2025-2026.json';
import stanfordCs336Doc from '../../data/stanford-cs336-language-modeling-spring2025.json';

const topicBySlug: Record<string, typeof nonequilibriumDoc> = {
  'nonequilibrium-lmu-ss2025': nonequilibriumDoc,
  'self-organization-lmu-ws2025-2026': selfOrganizationDoc,
  'stanford-cs336-language-modeling-spring2025': stanfordCs336Doc,
};

export function getStaticPaths() {
  return manifest.map((t) => ({ params: { slug: t.slug } }));
}

const slug = Astro.params.slug!;
const summary = manifest.find((t) => t.slug === slug);
const topic = topicBySlug[slug];

if (!summary || !topic) {
  return Astro.redirect('/');
}

const pageTitle = `${topic.topicTitle} · prompts`;
---

<Layout pageTitle={pageTitle} pageDescription={topic.courseLine}>
  <main class="flex flex-col text-text">
    <div class="relative flex min-h-screen flex-col items-center px-6 py-16">
      <div class="pointer-events-none absolute top-1/4 left-1/2 h-[520px] w-[520px] -translate-x-1/2 rounded-full opacity-[0.03]" style="background: radial-gradient(circle, #22d3ee 0%, transparent 70%);"></div>

      <div class="relative z-10 w-full max-w-3xl">
        <a
          href="/"
          class="group animate-fade-in-up mb-12 inline-flex items-center gap-2 text-sm opacity-0"
          style="animation-delay: 0s;"
        >
          <span class="text-muted transition-colors duration-200 group-hover:text-text">← all topics</span>
        </a>

        <header class="animate-fade-in-up mb-14 opacity-0" style="animation-delay: 0.03s;">
          <h1 class="text-text text-xl tracking-tight" transition:name={`topic-${slug}`}>{topic.topicTitle}</h1>
          <p class="text-muted mt-2 text-sm leading-relaxed">{topic.courseLine}</p>
          <p class="text-muted mt-2 text-[11px] tracking-wide">{topic.promptCount} prompts · opened rows show in accent color</p>
        </header>

        <nav class="flex flex-col gap-0" data-topic-slug={slug}>
          {topic.prompts.map((p, i) => (
            <a
              href={`https://chatgpt.com/?q=${encodeURIComponent(buildChatQuery(p))}`}
              target="_blank"
              rel="noopener noreferrer"
              data-prompt-id={p.id}
              class="group animate-fade-in-up relative flex items-start gap-4 py-3 opacity-0"
              style={`animation-delay: ${Math.min(0.06 + i * 0.012, 0.55)}s;`}
            >
              <span class="prompt-title text-subtle group-hover:text-text min-w-0 flex-1 text-left text-sm transition-colors duration-200 leading-relaxed">{p.title}</span>
              <span class="text-muted w-12 shrink-0 pt-0.5 text-right text-[11px] tabular-nums">{p.durationTimestamp}</span>
              <span class="text-muted shrink-0 pt-0.5 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"></path>
                  <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"></path>
                </svg>
              </span>
              <span class="bg-accent/40 absolute bottom-2 left-0 h-px w-0 transition-all duration-300 ease-out group-hover:w-full"></span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </main>

  <script is:inline>
    (function promptProgress() {
      var COOKIE = '100pua_prompt_clicked';
      function readMap() {
        try {
          var m = document.cookie.match(
            new RegExp('(?:^|; )' + COOKIE.replace(/[-\\^$*+?.()|[\\]{}]/g, '\\$&') + '=([^;]*)')
          );
          if (!m) return {};
          return JSON.parse(decodeURIComponent(m[1])) || {};
        } catch (_) {
          return {};
        }
      }
      function writeMap(map) {
        var encoded = encodeURIComponent(JSON.stringify(map));
        document.cookie =
          COOKIE + '=' + encoded + ';path=/;max-age=' + String(60 * 60 * 24 * 400) + ';samesite=lax';
      }
      function record(slugPart, pid) {
        var map = readMap();
        if (!map[slugPart]) map[slugPart] = {};
        map[slugPart][pid] = Date.now();
        writeMap(map);
      }
      function styleOpenedPrompt(a, opened) {
        var t = a.querySelector('.prompt-title');
        if (!t) return;
        if (opened) {
          t.classList.remove('text-subtle');
          t.classList.add('text-accent');
        } else {
          t.classList.remove('text-accent');
          t.classList.add('text-subtle');
        }
      }
      function paintFromCookie() {
        var nav = document.querySelector('nav[data-topic-slug]');
        if (!nav) return;
        var slugPart = nav.getAttribute('data-topic-slug');
        if (!slugPart) return;
        var doneFor = readMap()[slugPart] || {};
        nav.querySelectorAll('a[data-prompt-id]').forEach(function (a) {
          var id = a.getAttribute('data-prompt-id');
          if (id && doneFor[id]) styleOpenedPrompt(a, true);
        });
      }
      function onBodyClick(e) {
        var a = e.target && /** @type {Element} */ e.target.closest('a[data-prompt-id]');
        if (!a) return;
        var nav = a.closest('nav[data-topic-slug]');
        if (!nav) return;
        var slugPart = nav.getAttribute('data-topic-slug');
        var pid = a.getAttribute('data-prompt-id');
        if (slugPart && pid) {
          record(slugPart, pid);
          styleOpenedPrompt(a, true);
        }
      }
      function boot() {
        paintFromCookie();
      }
      if (!window.__pua_prompt_delegate) {
        window.__pua_prompt_delegate = true;
        document.body.addEventListener('click', onBodyClick);
      }
      if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
      document.addEventListener('astro:page-load', boot);
    })();
  </script>
</Layout>
