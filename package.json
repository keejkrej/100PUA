{
  "name": "100pua",
  "type": "module",
  "version": "0.0.1",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun scripts/build-prompt-index.ts && bun --bun vite build",
    "start": "bun .output/server/index.mjs",
    "prewarm:explain": "bun scripts/prewarm-explain-cache.ts",
